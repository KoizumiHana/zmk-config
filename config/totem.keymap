// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Nav         1
#define Sym         2

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        WinNav {
            bindings = <&sl 9>;
            key-positions = <13 16>;
        };

        toggle_mac {
            bindings = <&tog 1>;
            key-positions = <20 31>;
        };

        toggle_mouse {
            bindings = <&tog 10>;
            key-positions = <33 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base_win {
            display-name = "Base_win";
            bindings = <
           &kp Q       &kp W       &kp E         &kp R         &kp T        &kp Y      &kp U        &kp I         &kp O       &kp P
           &hm LGUI A  &hm LALT S  &hm LCTRL D   &hm LSHIFT F  &kp G        &kp H      &hm RSHFT J  &hm RCTRL K   &hm RALT L  &hm RGUI SEMICOLON
&kp GRAVE  &kp Z       &kp X       &kp C         &kp V         &kp B        &kp N      &kp M        &kp COMMA     &kp DOT     &kp SLASH           &kp SINGLE_QUOTE
                                   &lt 9 ESCAPE  &lt 2 SPACE   &lt 8 TAB    &kp ENTER  &lt 4 BSPC   &lt 6 DELETE
            >;
        };

        Base_mac {
            display-name = "Base_mac";
            bindings = <
           &kp Q        &kp W           &kp E           &kp R         &kp T        &kp Y      &kp U        &kp I            &kp O       &kp P
           &hm LCTRL A  &hm LEFT_ALT S  &hm LEFT_GUI D  &hm LSHIFT F  &kp G        &kp H      &hm RSHFT J  &hm RIGHT_GUI K  &hm RALT L  &hm RCTRL SEMICOLON
&kp GRAVE  &kp Z        &kp X           &kp C           &kp V         &kp B        &kp N      &kp M        &kp COMMA        &kp DOT     &kp SLASH            &kp SINGLE_QUOTE
                                        &kp ESCAPE      &lt 3 SPACE   &lt 8 TAB    &kp ENTER  &lt 5 BSPC   &lt 7 DELETE
            >;
        };

        Nav_win {
            bindings = <
        &trans     &trans     &trans     &trans     &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp HOME  &kp UP_ARROW  &kp END          &kp PAGE_UP
        &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp LEFT  &kp DOWN      &kp RIGHT_ARROW  &kp INS
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LEFT_BRACE          &kp RIGHT_BRACE        &trans    &trans        &trans           &kp PAGE_DOWN  &trans
                              &trans     &trans     &trans                  &kp ENTER              &kp BSPC  &kp DEL
            >;

            label = "Nav_win";
        };

        Nav_mac {
            bindings = <
        &trans     &trans     &trans        &trans     &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp HOME  &kp UP_ARROW  &kp END          &kp PAGE_UP
        &kp LCTRL  &kp LALT   &kp LEFT_GUI  &kp LSHFT  &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp LEFT  &kp DOWN      &kp RIGHT_ARROW  &kp INS
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)  &kp LEFT_BRACE          &kp RIGHT_BRACE        &trans    &trans        &trans           &kp PAGE_DOWN  &trans
                              &trans        &trans     &trans                  &kp ENTER              &kp BSPC  &kp DEL
            >;

            label = "Nav_mac";
        };

        Num_win {
            bindings = <
        &trans         &kp N7  &kp N8  &kp N9  &kp PLUS     &trans  &trans     &trans     &trans    &trans
        &kp BACKSLASH  &kp N4  &kp N5  &kp N6  &kp MINUS    &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &trans         &kp N1  &kp N2  &kp N3  &kp EQUAL    &trans  &trans     &trans     &trans    &trans    &trans
                               &trans  &kp N0  &trans       &trans  &trans     &trans
            >;

            label = "Num_win";
        };

        Num_mac {
            bindings = <
        &trans         &kp N7  &kp N8  &kp N9  &kp PLUS     &trans  &trans     &trans         &trans    &trans
        &kp BACKSLASH  &kp N4  &kp N5  &kp N6  &kp MINUS    &trans  &kp LSHFT  &kp RIGHT_GUI  &kp LALT  &kp RCTRL
&trans  &trans         &kp N1  &kp N2  &kp N3  &kp EQUAL    &trans  &trans     &trans         &trans    &trans     &trans
                               &trans  &kp N0  &trans       &trans  &trans     &trans
            >;

            label = " Num_mac";
        };

        Func_win {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &trans    &trans  &trans     &trans     &trans    &trans
        &kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans     &trans     &trans    &trans    &trans
                         &trans  &trans  &trans    &trans  &trans     &trans
            >;

            label = "Func_win";
        };

        Func_mac {
            bindings = <
        &kp F12  &kp F7  &kp F8  &kp F9  &trans    &trans  &trans     &trans         &trans    &trans
        &kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &kp LSHFT  &kp RIGHT_GUI  &kp LALT  &kp RCTRL
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans     &trans         &trans    &trans     &trans
                         &trans  &trans  &trans    &trans  &trans     &trans
            >;

            label = "Func_mac";
        };

        Sym {
            bindings = <
        &trans  &kp AMPERSAND  &kp KP_MULTIPLY  &trans     &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &kp DOLLAR     &kp PERCENT      &kp CARET  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp EXCL       &kp AT           &kp HASH   &trans    &trans  &trans  &trans  &trans  &trans  &trans
                               &trans           &trans     &trans    &trans  &trans  &trans
            >;

            label = "Sym";
        };

        Desk_win {
            bindings = <
        &trans  &kp LC(LG(N7))        &kp LC(LG(N8))  &kp LC(LG(N9))  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &kp LC(LG(N4))        &kp LC(LG(N5))  &kp LC(LG(N6))  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LC(LG(NUMBER_1))  &kp LC(LG(N2))  &kp LC(LG(N3))  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans          &trans          &trans    &trans  &trans  &trans
            >;

            label = "Desk_win";
        };

        Mouse {
            bindings = <
        &trans  &trans  &trans  &trans   &trans    &trans     &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &trans
        &trans  &trans  &trans  &tog 10  &trans    &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans   &trans    &trans     &trans          &trans          &trans           &trans  &trans
                        &trans  &trans   &trans    &mkp LCLK  &mkp MCLK       &mkp RCLK
            >;
        };
    };
};
